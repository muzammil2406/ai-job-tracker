{
  "name": "ai-job-tracker-db-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Knex scripts for the AI Job Tracker PostgreSQL database",
  "scripts": {
    "migration:make": "knex migrate:make --knexfile knexfile.js",
    "migrate:latest": "knex migrate:latest --knexfile knexfile.js",
    "report": "ts-node src/archive-report.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "knex": "^3.1.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}